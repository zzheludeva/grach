# Copy to .env.local. All variables are optional — without them the app runs in demo mode.

# AI Studio: enables the live "creative ping-pong" via the server route /api/ai/chat.
# Server-only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
ANTHROPIC_API_KEY=

# Supabase (public URL + anon key, protected by RLS). Schema: supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
